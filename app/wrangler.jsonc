{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benchmark-registry",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/client",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      },
      "routes": [
        {
          "pattern": "staging.benchmarkregistry.org",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "account_id": "1aed6fdb33b34b24c2914fcaaf48786b",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/client",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      },
      "routes": [
        {
          "pattern": "benchmarkregistry.org",
          "custom_domain": true
        },
        {
          "pattern": "www.benchmarkregistry.org",
          "custom_domain": true
        }
      ]
    }
  }
}
