{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benchmark-registry",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "STAGING_CRAWLER_PROTECTION": "enabled",
        "READ_ENVIRONMENT": "staging"
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "routes": [
        {
          "pattern": "staging.benchmarkregistry.org",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "READ_STORE",
          "id": "0bc4e56c19ab4a95966f0c81fe13a579"
        }
      ]
    },
    "production": {
      "account_id": "1aed6fdb33b34b24c2914fcaaf48786b",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "routes": [
        {
          "pattern": "benchmarkregistry.org",
          "custom_domain": true
        },
        {
          "pattern": "www.benchmarkregistry.org",
          "custom_domain": true
        }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "kv_namespaces": [
        {
          "binding": "READ_STORE",
          "id": "6063f8ffd85d416a9bc56c75ddf5ea12"
        }
      ],
      "vars": {
        "READ_ENVIRONMENT": "production"
      }
    }
  },
  "kv_namespaces": [
    {
      "binding": "READ_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "READ_ENVIRONMENT": "local"
  }
}
